":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Ingrained Superiority","points":5,"community11e":{"id":"ingrained-superiority-annihilation-legion","name":"Ingrained Superiority","detachment_id":"annihilation-legion","cost":5,"keyword_restrictions":["Necrons"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:annihilation-legion:enhancement:ingrained-superiority","detachmentId":"necrons:detachment:annihilation-legion","description":"NECRONS model only. Each time a model in the bearer's unit makes an attack, on a Critical Wound, improve the Armour Penetration characteristic of that attack by 1.","keywordRestrictions":["Necrons"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Soulless Reaper","points":15,"community11e":{"id":"soulless-reaper-annihilation-legion","name":"Soulless Reaper","detachment_id":"annihilation-legion","cost":15,"keyword_restrictions":["Destroyer Cult"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:annihilation-legion:enhancement:soulless-reaper","detachmentId":"necrons:detachment:annihilation-legion","description":"DESTROYER CULT model only. Each time an enemy unit within Engagement Range of the bearer's unit is selected to Fall Back, roll one D6. On a 3+, that unit cannot Fall Back and must Remain Stationary.","keywordRestrictions":["Destroyer Cult"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Enaegic Dermal Bond","points":30,"community11e":{"id":"enaegic-dermal-bond-awakened-dynasty","name":"Enaegic Dermal Bond","detachment_id":"awakened-dynasty","cost":30,"keyword_restrictions":["Necrons"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:awakened-dynasty:enhancement:enaegic-dermal-bond","detachmentId":"necrons:detachment:awakened-dynasty","description":"NECRONS model only. The bearer has the Feel No Pain 4+ ability.","keywordRestrictions":["Necrons"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Nether-realm Casket","points":20,"community11e":{"id":"nether-realm-casket-awakened-dynasty","name":"Nether-realm Casket","detachment_id":"awakened-dynasty","cost":20,"keyword_restrictions":["Necrons"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:awakened-dynasty:enhancement:nether-realm-casket","detachmentId":"necrons:detachment:awakened-dynasty","description":"NECRONS model only. While the bearer is leading a unit, models in that unit have the Stealth ability.","keywordRestrictions":["Necrons"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"