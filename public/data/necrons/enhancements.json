ictions":["Cryptek"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:canoptek-court:enhancement:autodivinator","detachmentId":"necrons:detachment:canoptek-court","description":"CRYPTEK model only. Each time your opponent gains a CP as a result of an ability, roll one D6: on a 2+, you also gain 1CP.","keywordRestrictions":["Cryptek"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Dimensional Sanctum","points":20,"community11e":{"id":"dimensional-sanctum-canoptek-court","name":"Dimensional Sanctum","detachment_id":"canoptek-court","cost":20,"keyword_restrictions":["Cryptek"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:canoptek-court:enhancement:dimensional-sanctum","detachmentId":"necrons:detachment:canoptek-court","description":"CRYPTEK model only. Models in the bearer's unit have the Infiltrators ability.","keywordRestrictions":["Cryptek"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Hyperphasic Fulcrum","points":15,"community11e":{"id":"hyperphasic-fulcrum-canoptek-court","name":"Hyperphasic Fulcrum","detachment_id":"canoptek-court","cost":15,"keyword_restrictions":["Cryptek"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":fa