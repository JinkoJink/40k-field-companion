ictions":["Cryptek"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:cryptek-conclave:enhancement:gravitic-bolas","detachmentId":"necrons:detachment:cryptek-conclave","description":"In your Shooting phase, after the bearer has shot, select one enemy unit hit by one or more of those attacks (excluding ^^**Titanic^^** units); until the start of your next turn, that enemy unit is pinned. While a unit is pinned, subtract 2 from that unit’s Move characteristic and subtract 2 from Charge rolls made for that unit.","keywordRestrictions":["CRYPTEK"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Quantum Abacus","points":15,"community11e":{"id":"quantum-abacus-cryptek-conclave","name":"Quantum Abacus","detachment_id":"cryptek-conclave","cost":15,"keyword_restrictions":["Necrons"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:cryptek-conclave:enhancement:quantum-abacus","detachmentId":"necrons:detachment:cryptek-conclave","description":"Each time you select the bearer’s unit as the target of a Stratagem, roll one D6, adding 1 if it is within range of one or more objectives: on a 4+, you gain 1CP.","keywordRestrictions":["NECRONS"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Cursed Circlet","points":25,"community11e":{"id":"cursed-circlet-cursed-legion","name":"Cursed Circlet","detachment_id":"cursed-legion","cost":25,"keyword_restrictions":["Destroyer Cult"],"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1},"id":"necrons:detachment:cursed-legion:enhancement:cursed-circlet","detachmentId":"necrons:detachment:cursed-legion","description":"Each time an enemy unit is selected to shoot, after that unit has shot, if any models from the bearer’s unit were destroyed as a result of those attacks, the bearer’s unit can make a Surge move. To do so, roll one D6: the bearer’s unit can be moved a number of inches up to the result, but the bearer’s unit must finish that move as close as possible to the closest enemy unit (excluding ^^**Aircraft^^**). \nWhen doing so, those models can be moved within Engagement Range of that enemy unit. A unit cannot make a Surge move while it is Battle‑shocked.","keywordRestrictions":["DESTROYER CULT"],"keywordRestrictionGroups":[],"exclusionKeywords":[],"allowedHosts":[],"attachmentBodyguardIds":[],"grantKeywords":[],"upgrade":false,"kind":"enhancement","countsTowardLimit":true,"mandatory":false,"maxTargets":1,"abilityId":null,"gameModes":[],"gameVersion":{"edition":"11th","dataslate":"launch"}},{"name":"Destroyer Ankh","points":20,"community11e":{"id":"destroyer-ankh-cursed-legion","name":"Destroyer Ankh","detachment_id":"cursed-legion","cost":20,"ability_id":null,"is_unique":true,"game_version":{"edition":"11th","dataslate":"launch"},"points_provisional":false,"upgrade_tag":false,"max_targets":1,"keyword_restriction_groups":[["Catacomb Command Barge"],["Overlord"]]},"id":"necrons:detachment:cursed-legion:enhancement:destroyer-ankh","detachmentId":"necrons:detachment:cursed-legion","description":"The bearer has the ^^**Destroyer Cult^^** keyword. Add 2\" to the Move characteristic of models in the bearer’s unit and add 2 to the Attacks ch